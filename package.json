{
  "name": "betwin-odds-radar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:import-only": "python3 scripts/import_sqlite.py",
    "db:update-matches": "python3 scripts/import_sqlite.py --json-only",
    "db:update-history": "node --disable-warning=ExperimentalWarning scripts/update_history.mjs",
    "db:import": "npm run db:import-only && npm run model:tune && npm run model:validate-three-way-probability && npm run model:tune-adaptive && npm run model:tune-segments",
    "db:refresh": "npm run db:import && npm run model:tune-weighting && npm run model:tune-smoothing && npm run model:tune-movement && npm run report:strategy-gates && npm run model:tune-reliability && npm run model:tune-goal-pair && npm run report:goal-zero && npm run report:goal-multiples && npm run verify:production-lock && npm test",
    "backtest:rolling": "node --disable-warning=ExperimentalWarning scripts/rolling_backtest.mjs",
    "compare:three-way-methods": "node --disable-warning=ExperimentalWarning scripts/compare_three_way_methods.mjs",
    "model:validate-three-way-probability": "node --disable-warning=ExperimentalWarning scripts/validate_three_way_probability.mjs",
    "model:tune": "node --disable-warning=ExperimentalWarning scripts/tune_parameters.mjs",
    "model:tune-adaptive": "node --disable-warning=ExperimentalWarning scripts/tune_adaptive_thresholds.mjs",
    "model:tune-segments": "node --disable-warning=ExperimentalWarning scripts/tune_segment_thresholds.mjs",
    "report:goal-zero": "node --disable-warning=ExperimentalWarning scripts/tune_goal_zero_odds.mjs",
    "model:tune-weighting": "node --disable-warning=ExperimentalWarning scripts/tune_weighting.mjs",
    "model:tune-movement": "node --disable-warning=ExperimentalWarning scripts/tune_movement.mjs",
    "model:tune-smoothing": "node --disable-warning=ExperimentalWarning scripts/tune_smoothing.mjs",
    "model:tune-reliability": "node --disable-warning=ExperimentalWarning scripts/tune_reliability.mjs",
    "model:tune-goal-pair": "node --disable-warning=ExperimentalWarning scripts/tune_goal_pair_selection.mjs",
    "report:strategy-gates": "node --disable-warning=ExperimentalWarning scripts/report_strategy_gates.mjs",
    "report:reliability-roi": "node --disable-warning=ExperimentalWarning scripts/report_reliability_roi.mjs",
    "report:value-bands": "node --disable-warning=ExperimentalWarning scripts/report_value_bands.mjs",
    "report:parlay-ledger": "node --disable-warning=ExperimentalWarning scripts/inspect_parlay_ledger.mjs",
    "report:parlay-math": "node --disable-warning=ExperimentalWarning scripts/report_parlay_math.mjs",
    "verify:production-lock": "node --disable-warning=ExperimentalWarning scripts/verify_production_lock.mjs",
    "model:train-challenger": "python3 scripts/train_challenger.py",
    "report:goal-multiples": "node --disable-warning=ExperimentalWarning scripts/generate_goal_multiple_report.mjs",
    "db:optimize": "node --disable-warning=ExperimentalWarning scripts/optimize_database.mjs",
    "diagnose:team-names": "node --disable-warning=ExperimentalWarning scripts/diagnose_team_aliases.mjs",
    "start": "node --disable-warning=ExperimentalWarning server.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.mjs && python3 -m unittest discover -s tests -p 'test_*.py'"
  }
}
